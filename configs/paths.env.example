# Copy this file to configs/paths.env and replace every /path/to value.
# The launchers accept the same values as exported environment variables.

GPUS=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
MASTER_PORT=29500

NUSCENES_ROOT=/path/to/nuscenes
DEPTH_ROOT_JSON=/path/to/nus_sampletoken2depthroot.json
RDEPTH_ROOT=/path/to/nus_Rdepth
DRIVE2GAUSS_PRETRAINED_ROOT=/path/to/pretrained
DRIVE2GAUSS_LATENT_MANIFESTS=/path/to/generated_latent_manifests
DRIVE2GAUSS_OUTPUT_ROOT=/path/to/outputs/generator_train
DRIVE2GAUSS_RESUME_CHECKPOINT=/path/to/checkpoints/drive2gauss_distt_step3600
DRIVE2GAUSS_INFERENCE_ROOT=/path/to/outputs/generator_inference
DRIVE2GAUSS_CHECKPOINT=/path/to/checkpoints/drive2gauss_distt_step3600/ema.pt

TRAIN_MANIFEST=/path/to/data/manifest_train.jsonl
TRAIN_CACHE_ROOT=/path/to/data/generated_latent_rgb_4f3v_train
VAL_MANIFEST=/path/to/data/manifest_val.jsonl
VAL_CACHE_ROOT=/path/to/data/generated_latent_rgbd_flow_full_val
GAUSSIAN_CHECKPOINT=/path/to/checkpoints/drive2gauss_feature_unet_step3744.pt
GAUSSIAN_OUTPUT_ROOT=/path/to/outputs/gaussian_decoder
GAUSSIAN_CHECKPOINT_ROOT=/path/to/checkpoints/gaussian_decoder
GAUSSIAN_DATA_ROOT=/path/to/nuscenes
GAUSSIAN_TRAIN_ANN_FILE=/path/to/nuscenes_infos_train.pkl
GAUSSIAN_VAL_ANN_FILE=/path/to/nuscenes_infos_val.pkl
GAUSSIAN_TRAIN_FLOW_RGB_ROOT=/path/to/train_masked_flow_rgb
GAUSSIAN_VAL_FLOW_RGB_ROOT=/path/to/val_masked_flow_rgb
GAUSSIAN_TRAIN_FLOW_INDEX=/path/to/train_flow_index.json
GAUSSIAN_VAL_FLOW_INDEX=/path/to/val_flow_index.json
GAUSSIAN_ALLOW_MISSING_FLOW_RGB=0
TORCH_EXTENSIONS_ROOT=/tmp/drive2gauss_gsplat_extensions
